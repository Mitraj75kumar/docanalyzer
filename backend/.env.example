# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=schema=DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/document_analyzer?schema=public"
# JWT
JWT_ACCESS_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_access_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google AI Studio (Gemini) API - used for summary/rewrite/translation/keywords/sentiment/chat
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Uploads
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=src/uploads

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
